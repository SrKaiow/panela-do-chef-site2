{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panela-do-chef-site2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "panela-do-chef-site2"
    }
  ],
  "observability": { "enabled": true },
  // Senhas e chaves ficam só no painel da Cloudflare (Variáveis e segredos), nunca aqui.
  // keep_vars: o deploy automático não apaga as variáveis criadas no painel.
  "keep_vars": true
}
