# Copie este arquivo para .env.local e preencha.

# Endereço público do site (sem barra no final). Usado nos links de volta do pagamento.
SITE_URL=http://localhost:3000

# Senha do painel de pedidos (/painel). Use uma senha forte.
ADMIN_PASSWORD=troque-esta-senha

# Senha da tela do entregador (/entregador), diferente da sua.
DRIVER_PASSWORD=troque-esta-senha-do-driver

# Banco de dados.
# Local: deixe como está (cria o arquivo pedidos.db na pasta do projeto).
# Produção (Vercel): crie um banco grátis no Turso (turso.tech) e cole a URL e o token.
DATABASE_URL=file:pedidos.db
DATABASE_AUTH_TOKEN=

# Pagamento online (Stripe): cartão, Apple Pay, Google Pay e transferência pelo banco (Pay by Bank).
# Se deixar vazio, o site só oferece dinheiro na entrega.
# Pegue as chaves em dashboard.stripe.com > Developers > API keys.
STRIPE_SECRET_KEY=
# Opcional: confirma o pagamento mesmo se o cliente fechar a página antes de voltar.
STRIPE_WEBHOOK_SECRET=

# Avisos automáticos no WhatsApp do cliente (opcional).
# Sem isso, o entregador e o painel mostram um botão que abre o WhatsApp com a mensagem pronta.
# Como configurar: veja a seção "Aviso no WhatsApp" do README.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_MODELO_SAIU=pedido_saiu
WHATSAPP_MODELO_CHEGANDO=pedido_chegando
WHATSAPP_IDIOMA=pt_BR

# Aviso de pedido novo no SEU WhatsApp (empresa), grátis pelo CallMeBot.
# Como pegar a chave: veja "Aviso de pedido no WhatsApp da empresa" no README.
CALLMEBOT_APIKEY=
# Número que recebe o aviso. Vazio = o telefone cadastrado no painel (07511505131).
WHATSAPP_LOJA=
